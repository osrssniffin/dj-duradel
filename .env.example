DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# The text channel that should contain the ONE persistent music panel.
MUSIC_CHANNEL_ID=

# Usually just "yt-dlp" if installed and on PATH.
YTDLP_PATH=yt-dlp

# Optional. Set these to expand Spotify album/playlist links.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Defaults
DEFAULT_VOLUME=0.70
IDLE_LEAVE_MINUTES=5
